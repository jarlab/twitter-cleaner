TYPESAFE_API_KEY=

# LLM keys: only for --driver browser-use with --hide auto|agent (the agent that operates a post's
# menu). Uncomment the one for the provider you pass to --llm. Ollama and local servers need none.
# OpenRouter (':free' models cost $0)
# OPENROUTER_API_KEY=
# Vercel AI Gateway (VERCEL_OIDC_TOKEN also works)
# AI_GATEWAY_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# BROWSER_USE_API_KEY=
# Only if Ollama isn't on the default http://localhost:11434
# OLLAMA_HOST=
